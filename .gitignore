data/model/dataset.parquet
data/model/dataset_match.parquet
data/model/*.joblib
data/model/optuna_study.db
data/model/predictions/
data/model/market_eval/

# Backups — cualquier variante de nombre (_bak.ext o .ext.bak)
data/model/*.bak
data/model/*_bak.*
data/model/_investigation_*

# ── Datos de referencia voluminosos o scrapeados ──────────────
data/reference/weather.parquet
data/reference/odds_*.parquet
data/reference/_*
data/reference/event_stats.parquet
data/reference/referee_stats.parquet

# ── Logs ──────────────────────────────────────────────────────
*.log
data/automation/*.log
logs/
!logs/.gitkeep

# ── Jupyter checkpoints ───────────────────────────────────────
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

