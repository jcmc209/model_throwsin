# Copia este fichero a .env y rellena los valores reales.
# El fichero .env NUNCA debe subirse al repositorio.

# ── MongoDB Atlas ──────────────────────────────────────────────
# URI de conexión completa. Obtenla en Atlas > Connect > Drivers.
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=mongodb+srv://usuario:contraseña@cluster0.example.mongodb.net/

# Nombre de la base de datos donde se guardan los datos.
# Por defecto: modelthrowins
MONGO_DB=modelthrowins
